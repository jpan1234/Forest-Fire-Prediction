# Load necessary libraries
library(MASS)        # For multivariate normal sampling
library(geoR)        # For inverse chi-squared sampling
library(mvnfast)     # For multivariate normal sampling
library(MCMCpack)    # For inverse gamma sampling
library(ggplot2)     # For plotting
# Load the dataset
df <- read.csv("ds4420_spotify.csv")
# Remove observation 107
df <- df[-107, ]
# Discard song title and artist name columns
df <- df[, !(names(df) %in% c("song_title", "artist_name"))]
# One-hot encode the 'explicit' column
df$explicit_yes <- ifelse(df$explicit == TRUE, 1, 0)
df <- df[, !(names(df) %in% "explicit")]
# Standardize/scale all features except for 'artist_pop' and 'track_pop'
features_to_scale <- setdiff(names(df), c("artist_pop", "track_pop"))
df[features_to_scale] <- scale(df[features_to_scale])
# Add a bias column (intercept term)
df$bias <- 1
# Separate the data into training and test sets (80-20 split)
set.seed(42)  # For reproducibility
train_index <- sample(1:nrow(df), size = 0.8 * nrow(df))
train_data <- df[train_index, ]
test_data <- df[-train_index, ]
# Extract predictors (X) and response (y) from training data
X <- as.matrix(train_data[, !(names(train_data) %in% "track_pop")])
y <- train_data$track_pop
n <- nrow(X)  # Number of observations
p <- ncol(X)  # Number of predictors
# Priors for w
prior_w <- rep(0, p)  # Prior mean for w
prior_Sigma <- 10 * diag(p)  # Prior covariance matrix for w
# Priors for σ_y^2
prior_alpha <- 2  # Shape parameter
prior_beta <- 1   # Scale parameter
# Gibbs sampling setup
num_samples <- 10000
gibbs_samples_w <- matrix(0, nrow = num_samples, ncol = p)
gibbs_samples_sigmay <- numeric(num_samples)
# Initialize
w_tilde_current <- rep(0, p)
sigma2_current <- 1
# Ensure w_tilde_current is a column vector
w_tilde_current <- matrix(w_tilde_current, ncol = 1)
# Run Gibbs sampler
for (i in 1:num_samples) {
# Conditional posterior for w
V <- solve((1 / sigma2_current) * t(X) %*% X + solve(prior_Sigma))
M <- V %*% ((1 / sigma2_current) * t(X) %*% y + solve(prior_Sigma) %*% prior_w)
w_tilde_current <- rmvn(1, mu = as.vector(M), sigma = V)
# Conditional posterior for sigma2
A <- prior_alpha + n / 2
residual <- y - X %*% t(w_tilde_current)
B <- prior_beta + sum(residual^2) / 2
sigma2_current <- rinvgamma(1, shape = A, scale = B)
# Store samples
gibbs_samples_w[i, ] <- w_tilde_current
gibbs_samples_sigmay[i] <- sigma2_current
}
# acf and convergence
# check convergence and mixing of weights
head(gibbs_samples_w)
plot(gibbs_samples_w[,1], type = "l") # change the index to examine the 7 weights
acf(gibbs_samples_w[,1]) # change the index to examine the 7 weights
# check convergence and mixing of variance term
head(gibbs_samples_sigmay)
plot(gibbs_samples_sigmay, type = "l")
acf(gibbs_samples_sigmay)
prior_mean_sigma2 <- prior_beta / (prior_alpha - 1)  # Mean of the inverse gamma distribution
for (j in 1:p) {
hist(gibbs_samples_w[, j],
main = paste("Posterior of w[", j, "]", sep = ""),
xlab = paste("w[", j, "]", sep = ""),
col = "blue",
breaks = 30,
probability = TRUE)
# Add a red line for the posterior mean
abline(v = mean(gibbs_samples_w[, j]), col = "red", lwd = 2, lty = 2)
# Add a green line for the prior mean
abline(v = prior_w[j], col = "green", lwd = 2, lty = 2)
legend("topright", legend = c("Posterior Mean", "Prior Mean"),
col = c("red", "green"), lty = c(2, 2), lwd = 2)
}
# Plot histogram for σ_y^2 with prior and posterior means
hist(gibbs_samples_sigmay,
main = "Posterior of σ_y^2",
xlab = "σ_y^2",
col = "green",
breaks = 30,
probability = TRUE)
# Add a red line for the posterior mean
abline(v = mean(gibbs_samples_sigmay), col = "green", lwd = 2, lty = 2)
abline(v = prior_mean_sigma2, col = "red", lwd = 2, lty = 2)
legend("topright", legend = c("Posterior Mean", "Prior Mean"),
col = c("green", "red"), lty = c(2, 2), lwd = 2)
# Extract test data
X_test <- as.matrix(test_data[, !(names(test_data) %in% "track_pop")])
y_test <- test_data$track_pop
# Generate posterior predictive samples
num_test <- nrow(X_test)
posterior_predictive_samples <- matrix(0, nrow = num_samples, ncol = num_test)
for (i in 1:num_samples) {
posterior_predictive_samples[i, ] <- X_test %*% gibbs_samples_w[i, ] + rnorm(num_test, mean = 0, sd = sqrt(gibbs_samples_sigmay[i]))
}
# Compute posterior predictive means
posterior_predictive_means <- colMeans(posterior_predictive_samples)
# Plot posterior predictive means vs true test values
plot(y_test, posterior_predictive_means, main = "Posterior Predictive Means vs True Test Values",
xlab = "True Test Values", ylab = "Posterior Predictive Means", col = "blue", pch = 16)
abline(0, 1, col = "red", lwd = 2, lty = 2)
# Calculate correlation between predictions and true test values
correlation <- cor(y_test, posterior_predictive_means)
print(paste("Correlation between predictions and true test values:", round(correlation, 3)))
