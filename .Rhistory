# Load necessary libraries
library(MASS)        # For multivariate normal sampling
library(geoR)        # For inverse chi-squared sampling
library(mvnfast)     # For multivariate normal sampling
library(MCMCpack)    # For inverse gamma sampling
library(ggplot2)     # For plotting
# Load the dataset
df <- read.csv("ds4420_spotify.csv")
# Remove observation 107
df <- df[-107, ]
# Discard song title and artist name columns
df <- df[, !(names(df) %in% c("song_title", "artist_name"))]
# One-hot encode the 'explicit' column
df$explicit_yes <- ifelse(df$explicit == TRUE, 1, 0)
df <- df[, !(names(df) %in% "explicit")]
# Standardize/scale all features except for 'artist_pop' and 'track_pop'
features_to_scale <- setdiff(names(df), c("artist_pop", "track_pop"))
df[features_to_scale] <- scale(df[features_to_scale])
# Add a bias column (intercept term)
df$bias <- 1
# Separate the data into training and test sets (80-20 split)
set.seed(42)  # For reproducibility
train_index <- sample(1:nrow(df), size = 0.8 * nrow(df))
train_data <- df[train_index, ]
test_data <- df[-train_index, ]
# Extract predictors (X) and response (y) from training data
X <- as.matrix(train_data[, !(names(train_data) %in% "track_pop")])
y <- train_data$track_pop
n <- nrow(X)  # Number of observations
p <- ncol(X)  # Number of predictors
# divide track pop by 100
train_data$track_pop <- train_data$track_pop / 100
# rescale the train data
train_data_scaled <- as.data.frame(scale(train_data[, !(names(train_data) %in% "bias")]))
train_data_scaled
train_data
