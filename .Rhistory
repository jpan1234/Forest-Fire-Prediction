col = c("green", "red"), lty = c(2, 2), lwd = 2)
# Extract test data
X_test <- as.matrix(test_data[, !(names(test_data) %in% "track_pop")])
y_test <- test_data$track_pop
# Generate posterior predictive samples
num_test <- nrow(X_test)
posterior_predictive_samples <- matrix(0, nrow = num_samples, ncol = num_test)
for (i in 1:num_samples) {
posterior_predictive_samples[i, ] <- X_test %*% gibbs_samples_w[i, ] + rnorm(num_test, mean = 0, sd = sqrt(gibbs_samples_sigmay[i]))
}
# Compute posterior predictive means
posterior_predictive_means <- colMeans(posterior_predictive_samples)
# Plot posterior predictive means vs true test values
plot(y_test, posterior_predictive_means, main = "Posterior Predictive Means vs True Test Values",
xlab = "True Test Values", ylab = "Posterior Predictive Means", col = "blue", pch = 16)
abline(0, 1, col = "red", lwd = 2, lty = 2)
# Calculate correlation between predictions and true test values
correlation <- cor(y_test, posterior_predictive_means)
print(paste("Correlation between predictions and true test values:", round(correlation, 3)))
