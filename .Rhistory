legend("topleft", legend = "y = x", col = "red", lty = 2, lwd = 2)
# Exclude the bias column from scaling
bias_column <- train_data$bias
train_data_scaled <- as.data.frame(scale(train_data[, !(names(train_data) %in% "bias")]))
# Load necessary libraries
library(brms)
# Define the formula for the Bayesian linear model
# Assuming 'track_pop' is the response variable and all other columns are predictors
formula <- track_pop ~ .
prior <- default_prior(
track_pop ~ .,
data = train_data_scaled,
family = gaussian()
)
# Fit the Bayesian linear model
track_pop_brm <- brm(
track_pop ~ .,  # Use all predictors except the one-hot encoded column
family = gaussian(),  # Gaussian family for linear regression
data = train_data_scaled,  # Training dataset
chains = 4,  # Number of chains
cores = getOption("mc.cores", 8),  # Number of cores for parallel processing
iter = 10000,  # Total iterations
warmup = 1800,  # Burn-in iterations
thin = 1,  # Thinning interval
seed = 42,  # For reproducibility
prior = prior
)
print(summary(track_pop_brm))
# posterior histogram and traceplot
# posterior predictive distribution
post_preds_pois <- posterior_predict(track_pop_brm)
# for Bulbasaur
track_post_preds_pois <- post_preds_pois[,1]
hist(track_post_preds_pois) # similar predictive power (via R^2) but seemingly much less uncertainty
mean(track_post_preds_pois)
#  bayes_R2()
bayes_R2(track_pop_brm)
# use posterior_predict() using test data
post_preds_brm <- posterior_predict(track_pop_brm, newdata = test_data)
# compare predictions to true test vals with a plot
plot(test_data$track_pop, colMeans(post_preds_brm),
xlab = "True Test Values",
ylab = "Posterior Predictive Means",
main = "Posterior Predictive Means vs True Test Values",
pch = 16, col = rgb(0, 0, 1, 0.5))  # Semi-transparent blue points
abline(a = 0, b = 1, col = "red", lty = 2, lwd = 2)  # Red dashed line
legend("topleft", legend = "y = x", col = "red", lty = 2, lwd = 2)
# calculate correlation between predictions and true test values
correlation_brm <- cor(test_data$track_pop, colMeans(post_preds_brm))
cat(sprintf("Correlation between predictions and true test values: %.3f\n", correlation_brm))
# calculate correlation between predictions and true test values
correlation_brm <- cor(test_data$track_pop, colMeans(post_preds_brm))
cat(sprintf("Correlation between predictions and true test values: %.3f\n", correlation_brm))
